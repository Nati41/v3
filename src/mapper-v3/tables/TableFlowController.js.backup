/**
 * TableFlowController - Controls the flow of table mapping through steps
 *
 * MIGRATED FROM: /src/shared/tables/tableStepController.js
 * ADAPTED FOR: Mapper V3 (EventBus-based, no direct UI dependencies)
 *
 * Changes from original:
 * - Removed direct UI dependencies (this.ui.*)
 * - Removed direct overlay dependencies (this.overlay.*)
 * - All UI communication via EventBus events
 * - UI components will listen to events and render accordingly
 *
 * Steps:
 * 0 - IDLE: Not in table mode
 * 1 - HEADER: Select table header row
 * 2 - SAMPLE_ROW: Select one example data row
 * 3 - COLUMNS: Draw columns within the sample row
 * 4 - ROW_COUNT: Enter total number of rows
 * 5 - GENERATE: Auto-generate all table cells
 * 6 - REVIEW: Final review and confirmation
 */

import { eventBus, Events } from '../core/EventBus.js';
import { TableModel } from './TableModel.js';
import { tableValidator } from './TableValidator.js';
import { autoBoxer } from '../engines/AutoBoxer.js';

// Table step enum - exported for external use
// NEW FLOW: tableBBox is FIRST (visual boundaries), then title (semantic), then sample row (row height source)
export const TableSteps = {
    IDLE: 0,
    SELECT_TABLE_BBOX: 1,  // Step 1: Mark entire table boundaries (REQUIRED - visual boundary)
    SELECT_TITLE: 2,       // Step 2: Select table title (semantic - for UI/JSON/autofill)
    SAMPLE_ROW: 3,         // Step 3: Select sample row (REQUIRED - row height source)
    COLUMNS: 4,            // Step 4: Define columns within sample row
    ROW_COUNT: 5,          // Step 5: Enter number of rows
    GENERATE: 6,           // Step 6: Generate table
    REVIEW: 7,             // Step 7: Review and confirm
};

// DEPRECATED: Kept for backwards compatibility
export const TableSteps_LEGACY = {
    HEADER: 1  // Old step - no longer used, use SELECT_TITLE instead
};

// Table-specific events (added to global Events)
export const TableEvents = {
    // Flow events
    TABLE_FLOW_STARTED: 'table:flowStarted',
    TABLE_FLOW_STEP_CHANGED: 'table:stepChanged',
    TABLE_FLOW_FINISHED: 'table:flowFinished',
    TABLE_FLOW_CANCELLED: 'table:flowCancelled',

    // UI control events (for external UI to listen to)
    TABLE_UI_LOCK_NEXT: 'table:ui:lockNext',
    TABLE_UI_UNLOCK_NEXT: 'table:ui:unlockNext',
    TABLE_UI_MESSAGE: 'table:ui:message',
    TABLE_UI_UPDATE_COLUMNS: 'table:ui:updateColumns',
    TABLE_UI_SHOW_SUMMARY: 'table:ui:showSummary',
    TABLE_UI_UPDATE_TITLE: 'table:ui:updateTitle',  // NEW: Show table title in UI

    // Overlay events (for external overlay renderer to listen to)
    TABLE_OVERLAY_SHOW_TABLE_BBOX: 'table:overlay:showTableBBox',  // NEW: Show user-defined table boundaries
    TABLE_OVERLAY_SHOW_TITLE: 'table:overlay:showTitle',  // Show title selection area
    TABLE_OVERLAY_SHOW_HEADER: 'table:overlay:showHeader',  // DEPRECATED: use showTitle
    TABLE_OVERLAY_SHOW_SAMPLE_ROW: 'table:overlay:showSampleRow',
    TABLE_OVERLAY_SHOW_COLUMN: 'table:overlay:showColumn',
    TABLE_OVERLAY_SHOW_ROW_HINT: 'table:overlay:showRowHint',
    TABLE_OVERLAY_SHOW_PREVIEW: 'table:overlay:showPreview',
    TABLE_OVERLAY_CLEAR_TEMP: 'table:overlay:clearTemp',
    TABLE_OVERLAY_CLEAR_COLUMNS: 'table:overlay:clearColumns',
    TABLE_OVERLAY_CLEAR_ALL: 'table:overlay:clearAll',
    TABLE_OVERLAY_HIGHLIGHT_AREA: 'table:overlay:highlightArea',

    // V3.9: Lock/unlock table structure during column drawing
    TABLE_OVERLAY_LOCK_STRUCTURE: 'table:overlay:lockStructure',
    TABLE_OVERLAY_UNLOCK_STRUCTURE: 'table:overlay:unlockStructure',

    // Drawing events
    TABLE_RECTANGLE_DRAWN: 'table:rectangleDrawn',

    // Column management events
    TABLE_PROMPT_COLUMN_DETAILS: 'table:promptColumnDetails',
    TABLE_COLUMN_DETAILS_RESULT: 'table:columnDetailsResult',

    // Title events (NEW)
    TABLE_TITLE_SELECTED: 'table:titleSelected',  // Title text extracted from selection
};

export class TableFlowController {
    /**
     * @param {number} page - Current page number
     */
    constructor(page = 1) {
        this.model = new TableModel(page);
        this.currentStep = TableSteps.IDLE;

        // Callbacks for integration
        this.onFinish = null;
        this.onCancel = null;

        // Pending column details promise
        this._pendingColumnPromise = null;

        // Listen for external events
        this._setupEventListeners();
    }

    /**
     * Setup event listeners for external interactions
     */
    _setupEventListeners() {
        // Listen for row count changes from UI
        eventBus.on('table:rowCountChanged', (value) => {
            this._handleRowCountChange(value);
        });

        // Listen for column details result from UI
        eventBus.on(TableEvents.TABLE_COLUMN_DETAILS_RESULT, (result) => {
            // Clear timeout since we got a response
            this._clearColumnDialogTimeout();

            if (this._pendingColumnPromise) {
                this._pendingColumnPromise.resolve(result);
                this._pendingColumnPromise = null;
            }
        });

        // Listen for column delete from UI
        eventBus.on('table:deleteColumn', (columnId) => {
            this.deleteColumn(columnId);
        });

        // Listen for column edit from UI
        eventBus.on('table:editColumn', (columnId) => {
            this.editColumn(columnId);
        });

        // V3.5: Listen for resize events from OverlayRenderer
        eventBus.on('table:resize:tableBBox', ({ bbox }) => {
            this._handleTableBBoxResize(bbox);
        });

        eventBus.on('table:resize:sampleRow', ({ bbox }) => {
            this._handleSampleRowResize(bbox);
        });

        eventBus.on('table:resize:column', ({ bbox, columnId }) => {
            this._handleColumnResize(bbox, columnId);
        });
    }

    /**
     * V3.5: Handle table bbox resize
     * @param {Object} bbox - New normalized bbox
     */
    _handleTableBBoxResize(bbox) {
        if (!this.isActive()) return;

        // Update model
        this.model.setTableBBox(bbox);

        // Show success message
        eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
            type: 'success',
            message: 'גבולות הטבלה עודכנו'
        });

        console.log('[TableFlowController] Table bbox resized:', bbox);
    }

    /**
     * V3.5: Handle sample row resize
     * @param {Object} bbox - New normalized bbox
     */
    _handleSampleRowResize(bbox) {
        if (!this.isActive()) return;

        // Update model
        this.model.setSampleRow(bbox);

        // Show success message with row height info
        const rowHeight = this.model.rowHeight;
        eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
            type: 'success',
            message: `שורה לדוגמא עודכנה (גובה: ${Math.round(rowHeight * 1000) / 1000})`
        });

        console.log('[TableFlowController] Sample row resized:', bbox);
    }

    /**
     * V3.5: Handle column resize
     * @param {Object} bbox - New normalized bbox
     * @param {string} columnId - Column ID
     */
    _handleColumnResize(bbox, columnId) {
        if (!this.isActive()) return;

        // Find column by ID
        const column = this.model.columns.find(c => c.columnId === columnId);
        if (column) {
            column.bbox = { ...bbox };

            // Show success message
            eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                type: 'success',
                message: `עמודה "${column.hebrewName || columnId}" עודכנה`
            });

            console.log('[TableFlowController] Column resized:', columnId, bbox);
        }
    }

    /**
     * Start the table mapping process
     */
    start() {
        // Reset the model to clear any previous data
        this.model.reset();

        // Emit flow started event
        eventBus.emit(TableEvents.TABLE_FLOW_STARTED, {
            tableId: this.model.tableId,
            page: this.model.page
        });

        // Jump to Step 1 (SELECT_TABLE_BBOX - mark entire table boundaries)
        this.goTo(TableSteps.SELECT_TABLE_BBOX);
    }

    /**
     * Handle row count input change
     * @param {number} value - Row count value
     */
    _handleRowCountChange(value) {
        if (this.currentStep !== TableSteps.ROW_COUNT) return;

        const validation = tableValidator.rowCount(value);

        if (validation.valid) {
            this.model.setRowCount(value);
            eventBus.emit(TableEvents.TABLE_UI_UNLOCK_NEXT);
        } else {
            eventBus.emit(TableEvents.TABLE_UI_LOCK_NEXT);
        }
    }

    /**
     * Go to a specific step
     * @param {number} step - Step number from TableSteps
     */
    goTo(step) {
        // Validate step is within valid range
        if (step < TableSteps.IDLE || step > TableSteps.REVIEW) {
            eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                type: 'error',
                message: 'שלב לא תקין'
            });
            return;
        }

        // Update current step
        this.currentStep = step;

        // Clear temporary overlays
        eventBus.emit(TableEvents.TABLE_OVERLAY_CLEAR_TEMP);

        // Clear columns for steps that need to rebuild them
        if (step !== TableSteps.COLUMNS && step !== TableSteps.ROW_COUNT) {
            eventBus.emit(TableEvents.TABLE_OVERLAY_CLEAR_COLUMNS);
        }

        // Emit step changed event (UI will update based on this)
        eventBus.emit(TableEvents.TABLE_FLOW_STEP_CHANGED, {
            step: step,
            model: this.model.getSummary()
        });

        // Handle step-specific logic
        switch (step) {
            case TableSteps.SELECT_TABLE_BBOX:
                // Step 1: Mark entire table boundaries (REQUIRED)
                // This is the visual boundary - all rows must fit within
                eventBus.emit(TableEvents.TABLE_UI_LOCK_NEXT);
                // Unlock if we already have tableBBox
                if (this.model.tableBBox) {
                    eventBus.emit(TableEvents.TABLE_OVERLAY_SHOW_TABLE_BBOX, {
                        bbox: this.model.tableBBox
                    });
                    eventBus.emit(TableEvents.TABLE_UI_UNLOCK_NEXT);
                }
                break;

            case TableSteps.SELECT_TITLE:
                // Step 2: Select table title (semantic - like text field mapping)
                // Show table bbox if already set
                if (this.model.tableBBox) {
                    eventBus.emit(TableEvents.TABLE_OVERLAY_SHOW_TABLE_BBOX, {
                        bbox: this.model.tableBBox
                    });
                }
                // Lock until title is selected
                eventBus.emit(TableEvents.TABLE_UI_LOCK_NEXT);
                // Unlock if we already have a title
                if (this.model.tableTitle.text) {
                    eventBus.emit(TableEvents.TABLE_UI_UPDATE_TITLE, {
                        title: this.model.tableTitle.text
                    });
                    eventBus.emit(TableEvents.TABLE_UI_UNLOCK_NEXT);
                }
                break;

            case TableSteps.SAMPLE_ROW:
                // Step 3: Select sample row (REQUIRED - row height source)
                // Show table bbox for reference
                if (this.model.tableBBox) {
                    eventBus.emit(TableEvents.TABLE_OVERLAY_SHOW_TABLE_BBOX, {
                        bbox: this.model.tableBBox
                    });
                }
                // Lock until sample row is drawn
                eventBus.emit(TableEvents.TABLE_UI_LOCK_NEXT);
                // Show table title if set (for reference only)
                if (this.model.tableTitle.text) {
                    eventBus.emit(TableEvents.TABLE_UI_UPDATE_TITLE, {
                        title: this.model.tableTitle.text
                    });
                }
                // Unlock if we already have sample row
                if (this.model.sampleRowBBox) {
                    eventBus.emit(TableEvents.TABLE_OVERLAY_SHOW_SAMPLE_ROW, {
                        bbox: this.model.sampleRowBBox
                    });
                    eventBus.emit(TableEvents.TABLE_UI_UNLOCK_NEXT);
                }
                break;

            case TableSteps.COLUMNS:
                // Step 4: Define columns within sample row
                // V3.9: Lock table structure (bbox + sample row) to prevent accidental resize
                eventBus.emit(TableEvents.TABLE_OVERLAY_LOCK_STRUCTURE);

                // Show table bbox for reference
                if (this.model.tableBBox) {
                    eventBus.emit(TableEvents.TABLE_OVERLAY_SHOW_TABLE_BBOX, {
                        bbox: this.model.tableBBox
                    });
                }
                // Lock until at least one column is defined
                eventBus.emit(TableEvents.TABLE_UI_LOCK_NEXT);
                // Show sample row hint and highlight drawing area
                if (this.model.sampleRowBBox) {
                    eventBus.emit(TableEvents.TABLE_OVERLAY_SHOW_SAMPLE_ROW, {
                        bbox: this.model.sampleRowBBox
                    });
                    eventBus.emit(TableEvents.TABLE_OVERLAY_HIGHLIGHT_AREA, {
                        bbox: this.model.sampleRowBBox
                    });
                }
                // Show existing columns
                this.model.columns.forEach((col, idx) => {
                    eventBus.emit(TableEvents.TABLE_OVERLAY_SHOW_COLUMN, {
                        index: idx,
                        bbox: col.bbox,
                        name: col.hebrewName,
                        layout: col.layout
                    });
                });
                // Update column list in UI
                eventBus.emit(TableEvents.TABLE_UI_UPDATE_COLUMNS, {
                    columns: this.model.columns
                });
                // Unlock if we already have columns
                if (this.model.columns.length > 0) {
                    eventBus.emit(TableEvents.TABLE_UI_UNLOCK_NEXT);
                }
                break;

            case TableSteps.ROW_COUNT:
                // Step 5: Enter number of rows
                // V3.9: Unlock table structure when leaving COLUMNS step
                eventBus.emit(TableEvents.TABLE_OVERLAY_UNLOCK_STRUCTURE);

                // Show table bbox for reference
                if (this.model.tableBBox) {
                    eventBus.emit(TableEvents.TABLE_OVERLAY_SHOW_TABLE_BBOX, {
                        bbox: this.model.tableBBox
                    });
                }
                // Lock until row count is entered
                eventBus.emit(TableEvents.TABLE_UI_LOCK_NEXT);
                // Show sample row and columns preview
                if (this.model.sampleRowBBox) {
                    eventBus.emit(TableEvents.TABLE_OVERLAY_SHOW_SAMPLE_ROW, {
                        bbox: this.model.sampleRowBBox
                    });
                }
                this.model.columns.forEach((col, idx) => {
                    eventBus.emit(TableEvents.TABLE_OVERLAY_SHOW_COLUMN, {
                        index: idx,
                        bbox: col.bbox,
                        name: col.hebrewName,
                        layout: col.layout
                    });
                });
                // Unlock if we already have row count
                if (this.model.rowCount > 0) {
                    eventBus.emit(TableEvents.TABLE_UI_UNLOCK_NEXT);
                }
                break;

            case TableSteps.GENERATE:
                // Lock during generation
                eventBus.emit(TableEvents.TABLE_UI_LOCK_NEXT);
                // Auto-generate rows
                this._generateTable();
                break;

            case TableSteps.REVIEW:
                // Unlock for final confirmation
                eventBus.emit(TableEvents.TABLE_UI_UNLOCK_NEXT);
                // Show preview
                eventBus.emit(TableEvents.TABLE_OVERLAY_SHOW_PREVIEW, {
                    model: this.model.toJSON()
                });
                // Show summary in UI
                eventBus.emit(TableEvents.TABLE_UI_SHOW_SUMMARY, {
                    summary: this.model.getSummary()
                });
                break;

            case TableSteps.IDLE:
            default:
                // Nothing special
                break;
        }
    }

    /**
     * Move to next step
     */
    next() {
        const step = this.currentStep;

        // Validate current step before progressing
        const validation = tableValidator.validateStep(step, this.model);

        if (!validation.valid) {
            eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                type: 'error',
                message: validation.error || 'יש להשלים את השלב הנוכחי'
            });
            return;
        }

        // If we're at the review step, finish the process
        if (step === TableSteps.REVIEW) {
            this.finish();
            return;
        }

        // Move to next step
        this.goTo(step + 1);
    }

    /**
     * Go back to previous step
     * V3.5: Skip GENERATE step since it auto-advances to REVIEW
     */
    back() {
        if (this.currentStep > TableSteps.SELECT_TABLE_BBOX) {
            let targetStep = this.currentStep - 1;

            // V3.5: Skip GENERATE step when going back from REVIEW
            // GENERATE auto-advances to REVIEW, so going back to it creates a loop
            if (targetStep === TableSteps.GENERATE) {
                targetStep = TableSteps.ROW_COUNT;
            }

            this.goTo(targetStep);
        }
    }

    /**
     * Cancel table mapping and reset
     */
    cancel() {
        // Reset model
        this.model.reset();

        // Clear all overlays
        eventBus.emit(TableEvents.TABLE_OVERLAY_CLEAR_ALL);

        // Set step to IDLE
        this.currentStep = TableSteps.IDLE;

        // Show cancellation message
        eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
            type: 'info',
            message: 'מיפוי הטבלה בוטל'
        });

        // Emit flow cancelled event
        eventBus.emit(TableEvents.TABLE_FLOW_CANCELLED, {
            tableId: this.model.tableId
        });

        // Call cancel callback if provided
        if (this.onCancel && typeof this.onCancel === 'function') {
            this.onCancel();
        }
    }

    /**
     * Complete the table mapping
     */
    finish() {
        // Validate all data
        const validation = tableValidator.complete(this.model);

        if (!validation.valid) {
            eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                type: 'error',
                message: validation.errors.join(', ')
            });
            return;
        }

        // Mark table as complete
        this.model.isComplete = true;
        this.model.createdAt = new Date().toISOString();

        // Get the table data in mapping-compatible format
        const tableData = this.model.toMappingJSON();

        // Also generate field overlays for the mapper
        const fieldOverlays = this.model.generateFieldOverlays();

        console.log('[TableFlowController] Table finished:', {
            tableId: tableData.tableId,
            columns: tableData.columns.length,
            rows: tableData.rows.length,
            fieldOverlays: fieldOverlays.length
        });

        // Clear all overlays
        eventBus.emit(TableEvents.TABLE_OVERLAY_CLEAR_ALL);

        // Reset step to IDLE
        this.currentStep = TableSteps.IDLE;

        // Show success message
        eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
            type: 'success',
            message: 'הטבלה נשמרה בהצלחה!'
        });

        // Emit flow finished event
        eventBus.emit(TableEvents.TABLE_FLOW_FINISHED, {
            tableData: tableData,
            fieldOverlays: fieldOverlays
        });

        // Emit standard table created event
        eventBus.emit(Events.TABLE_CREATED, tableData);

        // Call the finish callback if provided
        if (this.onFinish && typeof this.onFinish === 'function') {
            this.onFinish(tableData, fieldOverlays);
        }

        return tableData;
    }

    /**
     * Get current step
     * @returns {number} Current step number
     */
    getCurrentStep() {
        return this.currentStep;
    }

    /**
     * Check if in table mapping mode
     * @returns {boolean} True if in table mode
     */
    isActive() {
        return this.currentStep !== TableSteps.IDLE;
    }

    /**
     * Internal: Generate the table
     * Creates all rows based on sample row and columns
     *
     * CRITICAL: All row calculations are based on sampleRowBBox ONLY
     * headerRowBBox is OPTIONAL and only affects table bbox top
     */
    _generateTable() {
        // Precondition checks
        // NOTE: tableTitle is semantic only - not required for geometry
        // NOTE: headerRowBBox is OPTIONAL - does not affect row calculations
        if (!this.model.tableBBox) {
            eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                type: 'error',
                message: 'חסרים גבולות הטבלה - חזור לשלב 1'
            });
            return;
        }
        if (!this.model.sampleRowBBox) {
            eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                type: 'error',
                message: 'חסרה שורה לדוגמא - חזור לשלב 3'
            });
            return;
        }
        if (this.model.columns.length === 0) {
            eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                type: 'error',
                message: 'לא הוגדרו עמודות - חזור לשלב 4'
            });
            return;
        }
        if (this.model.rowCount <= 0) {
            eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                type: 'error',
                message: 'מספר שורות לא תקין - חזור לשלב 5'
            });
            return;
        }

        // Compute row height from sample row
        this.model.computeRowHeightFromSampleRow();

        // Generate all rows
        const rows = this.model.generateRows();

        if (rows.length > 0) {
            const totalCells = rows.length * this.model.columns.length;
            eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                type: 'success',
                message: `נוצרו ${rows.length} שורות (${totalCells} תאים)`
            });

            // Show loading briefly then proceed to review
            setTimeout(() => {
                if (this.currentStep === TableSteps.GENERATE) {
                    this.goTo(TableSteps.REVIEW);
                }
            }, 500);
        } else {
            eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                type: 'error',
                message: 'לא ניתן ליצור שורות - בדוק את ההגדרות'
            });
        }
    }

    // ============ DRAWING HANDLERS ============

    /**
     * Handle pointer down event
     * @param {Event} evt - Mouse event
     * @param {number} x - X coordinate
     * @param {number} y - Y coordinate
     * @returns {boolean} false to block underlying handlers, true to allow
     */
    handlePointerDown(evt, x, y) {
        if (!this.isActive()) {
            return true; // Allow other modes when table mode is off
        }

        // Block other modes while table mode is active
        evt.stopPropagation();
        return false; // Signal to start drawing for table
    }

    /**
     * Handle completed rectangle drawing
     * @param {Object} bbox - Bounding box { x, y, width, height }
     */
    onRectangleDrawn(bbox) {
        if (!this.isActive()) return;

        switch (this.currentStep) {
            case TableSteps.SELECT_TABLE_BBOX:
                this._handleTableBBoxDraw(bbox);
                break;

            case TableSteps.SELECT_TITLE:
                this._handleTitleDraw(bbox);
                break;

            case TableSteps.SAMPLE_ROW:
                this._handleSampleRowDraw(bbox);
                break;

            case TableSteps.COLUMNS:
                this._handleColumnDraw(bbox);
                break;

            default:
                console.log('[TableFlowController] Rectangle drawn in unexpected step:', this.currentStep);
                break;
        }
    }

    // ============ AUTOBOXER CLICK MODE ============

    /**
     * Handle single click for AutoBoxer-based cell detection
     * Uses pixel-based physics to detect cell boundaries from a click point
     *
     * @param {number} clickX - Click X in screen coordinates
     * @param {number} clickY - Click Y in screen coordinates
     * @returns {Promise<boolean>} True if bbox was computed and handled
     */
    async onClickForAutoBox(clickX, clickY) {
        if (!this.isActive()) return false;
        if (this.currentStep !== TableSteps.COLUMNS) return false;

        // Get overlay dimensions for coordinate conversion
        const overlayLayer = document.getElementById('overlay-layer');
        if (!overlayLayer) return false;

        const layerWidth = overlayLayer.offsetWidth;
        const layerHeight = overlayLayer.offsetHeight;

        // Set existing columns as neighbors (convert normalized to screen coords)
        const existingColumnBboxes = this.model.columns
            .filter(c => c.bbox)
            .map(c => ({
                x: c.bbox.x * layerWidth,
                y: c.bbox.y * layerHeight,
                width: c.bbox.width * layerWidth,
                height: c.bbox.height * layerHeight
            }));

        autoBoxer.setNeighborFields(existingColumnBboxes);

        // Compute bbox using AutoBoxer (returns screen pixels)
        const bbox = await autoBoxer.computeBbox(clickX, clickY);

        if (!bbox) {
            eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                type: 'warning',
                message: 'לא זוהו גבולות תא במיקום זה'
            });
            return false;
        }

        // Constrain bbox to sample row bounds (convert normalized to screen)
        if (this.model.sampleRowBBox) {
            const rowNorm = this.model.sampleRowBBox;
            const row = {
                x: rowNorm.x * layerWidth,
                y: rowNorm.y * layerHeight,
                width: rowNorm.width * layerWidth,
                height: rowNorm.height * layerHeight
            };

            bbox.y = row.y;
            bbox.height = row.height;

            if (bbox.x < row.x) {
                bbox.width -= (row.x - bbox.x);
                bbox.x = row.x;
            }
            if (bbox.x + bbox.width > row.x + row.width) {
                bbox.width = row.x + row.width - bbox.x;
            }
        }

        // Convert back to normalized coordinates for storage
        const normalizedBbox = {
            x: bbox.x / layerWidth,
            y: bbox.y / layerHeight,
            width: bbox.width / layerWidth,
            height: bbox.height / layerHeight
        };

        this._handleColumnDraw(normalizedBbox);
        return true;
    }

    /**
     * Check if current step supports AutoBoxer click mode
     * @returns {boolean}
     */
    supportsAutoBoxClick() {
        return this.isActive() && this.currentStep === TableSteps.COLUMNS;
    }

    /**
     * Handle table bbox rectangle drawing (Step 1)
     * User marks the ENTIRE table visual boundaries
     * This is REQUIRED and becomes the absolute source of truth for table boundaries
     * @param {Object} bbox - Bounding box { x, y, width, height }
     */
    _handleTableBBoxDraw(bbox) {
        // Validate the table bbox (similar to header validation)
        const validation = tableValidator.tableBBox ? tableValidator.tableBBox(bbox) : tableValidator.header(bbox);

        if (!validation.valid) {
            eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                type: 'error',
                message: validation.error || 'גבולות הטבלה קטנים מדי'
            });
            return;
        }

        // Save to model (this is the absolute source of truth for table boundaries)
        this.model.setTableBBox(bbox);

        // Show overlay
        eventBus.emit(TableEvents.TABLE_OVERLAY_SHOW_TABLE_BBOX, { bbox });

        // Unlock NEXT button
        eventBus.emit(TableEvents.TABLE_UI_UNLOCK_NEXT);

        // Show success message
        eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
            type: 'success',
            message: 'גבולות הטבלה נקבעו'
        });

        // Auto-advance after 500ms
        setTimeout(() => {
            if (this.currentStep === TableSteps.SELECT_TABLE_BBOX) {
                this.next();
            }
        }, 500);
    }

    /**
     * Handle title rectangle drawing (Step 2)
     * User draws rectangle on table title text - we extract the text
     * This is SEMANTIC only - not used for geometry
     * @param {Object} bbox - Bounding box { x, y, width, height }
     */
    async _handleTitleDraw(bbox) {
        // Validate the selection
        const validation = tableValidator.header(bbox);  // Reuse header validation for size

        if (!validation.valid) {
            eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                type: 'error',
                message: validation.error || 'אזור הכותרת קטן מדי'
            });
            return;
        }

        // Show loading message
        eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
            type: 'info',
            message: 'מחלץ כותרת...'
        });

        try {
            // Import text extractor dynamically to avoid circular deps
            const { textExtractor } = await import('../engines/TextExtractor.js');

            // Extract text from the selected area
            // Need to convert bbox to screen coordinates for text extraction
            const overlayLayer = document.getElementById('overlay-layer');
            let screenX = bbox.x, screenY = bbox.y, screenW = bbox.width, screenH = bbox.height;

            // If bbox is normalized (0-1), convert to screen pixels
            if (bbox.x <= 1 && bbox.y <= 1 && bbox.width <= 1 && bbox.height <= 1 && overlayLayer) {
                const layerWidth = overlayLayer.offsetWidth;
                const layerHeight = overlayLayer.offsetHeight;
                screenX = bbox.x * layerWidth;
                screenY = bbox.y * layerHeight;
                screenW = bbox.width * layerWidth;
                screenH = bbox.height * layerHeight;
            }

            const { text, source } = await textExtractor.getTextAtPosition(screenX, screenY, screenW, screenH);

            if (!text) {
                eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                    type: 'warning',
                    message: 'לא נמצא טקסט - נסה שוב או הזן ידנית'
                });
                return;
            }

            // Set the table title (semantic only - NOT for geometry)
            this.model.setTableTitle(text, bbox);

            // Show visual feedback (optional - just for reference)
            eventBus.emit(TableEvents.TABLE_OVERLAY_SHOW_TITLE, { bbox, text });

            // Update UI with title
            eventBus.emit(TableEvents.TABLE_UI_UPDATE_TITLE, { title: text });

            // Unlock NEXT button
            eventBus.emit(TableEvents.TABLE_UI_UNLOCK_NEXT);

            // Show success message
            eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                type: 'success',
                message: `שם הטבלה: "${text}"`
            });

            // Auto-advance after 600ms
            setTimeout(() => {
                if (this.currentStep === TableSteps.SELECT_TITLE) {
                    this.next();
                }
            }, 600);

        } catch (error) {
            console.error('[TableFlowController] Title extraction error:', error);
            eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                type: 'error',
                message: 'שגיאה בחילוץ כותרת'
            });
        }
    }

    /**
     * Handle sample row rectangle drawing (Step 3)
     * CRITICAL: This is the source of truth for row HEIGHT
     * Row positions use tableBBox for boundaries, but sampleRow for height calculation
     * @param {Object} bbox - Bounding box { x, y, width, height }
     */
    _handleSampleRowDraw(bbox) {
        // Validate sample row (no longer validates against headerBBox)
        const validation = tableValidator.row(bbox, null);  // null = no header requirement

        if (!validation.valid) {
            eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                type: 'error',
                message: validation.error || 'שורת הדוגמא לא תקינה'
            });
            return;
        }

        // Save to model (this is THE source of truth for all row geometry)
        this.model.setSampleRow(bbox);

        // Show overlay
        eventBus.emit(TableEvents.TABLE_OVERLAY_SHOW_SAMPLE_ROW, { bbox });

        // Unlock NEXT button
        eventBus.emit(TableEvents.TABLE_UI_UNLOCK_NEXT);

        // Show success message with row height info
        const rowHeight = this.model.rowHeight;
        eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
            type: 'success',
            message: `שורה לדוגמא נבחרה (גובה: ${Math.round(rowHeight)}px)`
        });

        // Auto-advance after 500ms
        setTimeout(() => {
            if (this.currentStep === TableSteps.SAMPLE_ROW) {
                this.next();
            }
        }, 500);
    }

    /**
     * Handle column rectangle drawing
     * V3.9: Simplified flow - add column immediately with auto-generated name
     * User can edit names later via sidebar
     * @param {Object} bbox - Bounding box { x, y, width, height }
     */
    _handleColumnDraw(bbox) {
        // Validate the column
        const validation = tableValidator.column(
            bbox,
            this.model.sampleRowBBox,
            this.model.columns
        );

        if (!validation.valid) {
            eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                type: 'error',
                message: validation.error || 'העמודה לא תקינה'
            });
            return;
        }

        // V3.9: Add column immediately with auto-generated name (no dialog blocking)
        const columnNumber = this.model.columns.length + 1;
        const name = `עמודה ${columnNumber}`;
        const type = 'text';
        const layout = null;

        // Add column to model
        const column = this.model.addColumn(bbox, name, type, layout);

        // Show column overlay
        eventBus.emit(TableEvents.TABLE_OVERLAY_SHOW_COLUMN, {
            index: this.model.columns.length - 1,
            bbox: bbox,
            name: name,
            columnId: column.columnId,
            layout: column.layout
        });

        // Update the column list
        eventBus.emit(TableEvents.TABLE_UI_UPDATE_COLUMNS, {
            columns: this.model.columns
        });

        // Unlock NEXT if we have at least one column
        if (this.model.columns.length > 0) {
            eventBus.emit(TableEvents.TABLE_UI_UNLOCK_NEXT);
        }

        // Show brief success feedback
        eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
            type: 'success',
            message: `עמודה ${columnNumber} נוספה`
        });

        console.log(`[TableFlowController] Column ${columnNumber} added instantly`);
    }

    /**
     * Prompt for column details via EventBus
     * @param {string} defaultName - Default column name
     * @param {string} defaultType - Default column type
     * @returns {Promise<{name: string, type: string}|null>}
     */
    _promptColumnDetails(defaultName = '', defaultType = 'text') {
        return new Promise((resolve, reject) => {
            // Store promise handlers
            this._pendingColumnPromise = { resolve, reject };

            // Emit event asking UI to show prompt
            eventBus.emit(TableEvents.TABLE_PROMPT_COLUMN_DETAILS, {
                defaultName,
                defaultType
            });

            // Timeout after 60 seconds - resolve with null to trigger warning
            this._columnDialogTimeout = setTimeout(() => {
                if (this._pendingColumnPromise) {
                    console.log('[TableFlowController] Column dialog timeout');
                    this._pendingColumnPromise.resolve(null);  // Use resolve(null) for consistent handling
                    this._pendingColumnPromise = null;
                }
            }, 60000);
        });
    }

    /**
     * Clear column dialog timeout
     * Called when dialog is closed before timeout
     */
    _clearColumnDialogTimeout() {
        if (this._columnDialogTimeout) {
            clearTimeout(this._columnDialogTimeout);
            this._columnDialogTimeout = null;
        }
    }

    /**
     * Edit a column's details
     * @param {string} columnId - Column ID to edit
     */
    editColumn(columnId) {
        const column = this.model.columns.find(c => c.columnId === columnId);
        if (!column) return;

        this._promptColumnDetails(column.hebrewName, column.type)
            .then(({ name, type }) => {
                this.model.updateColumn(columnId, {
                    hebrewName: name,
                    type: type
                });

                // Update column list
                eventBus.emit(TableEvents.TABLE_UI_UPDATE_COLUMNS, {
                    columns: this.model.columns
                });

                // Update overlay - re-render all columns
                eventBus.emit(TableEvents.TABLE_OVERLAY_CLEAR_COLUMNS);
                this.model.columns.forEach((col, idx) => {
                    eventBus.emit(TableEvents.TABLE_OVERLAY_SHOW_COLUMN, {
                        index: idx,
                        bbox: col.bbox,
                        name: col.hebrewName,
                        layout: col.layout
                    });
                });

                eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
                    type: 'success',
                    message: 'העמודה עודכנה'
                });
            })
            .catch(() => {
                // User cancelled
            });
    }

    /**
     * Delete a column
     * @param {string} columnId - Column ID to delete
     */
    deleteColumn(columnId) {
        this.model.removeColumn(columnId);

        // Update column list
        eventBus.emit(TableEvents.TABLE_UI_UPDATE_COLUMNS, {
            columns: this.model.columns
        });

        // Redraw column overlays
        eventBus.emit(TableEvents.TABLE_OVERLAY_CLEAR_COLUMNS);
        this.model.columns.forEach((col, idx) => {
            eventBus.emit(TableEvents.TABLE_OVERLAY_SHOW_COLUMN, {
                index: idx,
                bbox: col.bbox,
                name: col.hebrewName,
                layout: col.layout
            });
        });

        // Lock NEXT if no columns left
        if (this.model.columns.length === 0) {
            eventBus.emit(TableEvents.TABLE_UI_LOCK_NEXT);
        }

        eventBus.emit(TableEvents.TABLE_UI_MESSAGE, {
            type: 'info',
            message: 'העמודה נמחקה'
        });
    }

    /**
     * Get the current model
     * @returns {TableModel}
     */
    getModel() {
        return this.model;
    }
}
